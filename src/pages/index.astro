---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Websites for Northern Ireland Solicitors | NI Solicitor Websites"
  description="Professional, easy-to-manage websites built specifically for solicitors and law firms across Northern Ireland."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">For Northern Ireland law firms</span>
      <h1>Websites built for solicitors, not agencies</h1>
      <p class="lede">
        Clear, professional websites that win the right enquiries, looked after
        by one person who actually answers the phone.
      </p>
      <div class="hero-cta">
        <a href="/#contact" class="btn">Get a free website review</a>
        <a href="/blog" class="btn btn--ghost">Read the guides</a>
      </div>
    </div>

    <!-- grainy gradient wave -->
    <div class="hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 420" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="waveGrad" x1="0" y1="0" x2="1" y2="0.4">
            <stop offset="0%" stop-color="#2f5fd8" />
            <stop offset="30%" stop-color="#e8b04b" />
            <stop offset="62%" stop-color="#2f5fd8" />
            <stop offset="100%" stop-color="#e8b04b" />
          </linearGradient>
          <filter id="grain">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" result="noise" />
            <feColorMatrix in="noise" type="saturate" values="0" result="desat" />
            <feComponentTransfer in="desat" result="grain">
              <feFuncA type="linear" slope="0.55" intercept="0" />
            </feComponentTransfer>
            <feComposite in="grain" in2="SourceGraphic" operator="in" />
          </filter>
          <filter id="soften">
            <feGaussianBlur stdDeviation="6" />
          </filter>
        </defs>

        <!-- soft base ribbon -->
        <path filter="url(#soften)"
          d="M -40 250 C 220 150, 420 360, 720 270 S 1180 140, 1480 250 L 1480 460 L -40 460 Z"
          fill="url(#waveGrad)" opacity="0.55" />
        <!-- crisper ribbon with grain texture -->
        <path filter="url(#grain)"
          d="M -40 270 C 240 180, 460 380, 740 290 S 1200 170, 1480 270 L 1480 460 L -40 460 Z"
          fill="url(#waveGrad)" opacity="0.9" />
      </svg>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Everything your firm's website needs, handled</h2>
      </div>
      <div class="card-grid">
        <div class="feature-card">
          <h3>New websites</h3>
          <p>A clean, credible site that reflects how your firm actually works, built to be found and easy to update.</p>
        </div>
        <div class="feature-card">
          <h3>Redesigns &amp; rescues</h3>
          <p>Tired, slow or broken sites brought up to standard without the agency runaround or the agency invoice.</p>
        </div>
        <div class="feature-card">
          <h3>Ongoing care</h3>
          <p>Updates, security, backups and small changes kept on top of, so you never have to think about it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT GUIDES -->
  {posts.length > 0 && (
    <section class="section" style="background:var(--paper-3); border-top:1px solid var(--line);">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Guides</span>
          <h2>Plain-English advice for law firms</h2>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <a class="post-card" href={`/blog/${post.slug}`}>
              <div class="post-meta">
                <span class="post-tag">{post.data.tag}</span>
                <span class="post-date">
                  {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-inner">
        <span class="eyebrow">Get in touch</span>
        <h2>Free website review</h2>
        <p>Tell us about your firm's site and we'll take a proper look. No obligation, no sales pitch.</p>
        <div class="fillout-wrapper">
          <div
            style="width:100%;height:500px;"
            data-fillout-id="jYdzYYJ7r9us"
            data-fillout-embed-type="standard"
            data-fillout-inherit-parameters
            data-fillout-dynamic-resize
          ></div>
          <script src="https://server.fillout.com/embed/v1/"></script>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
