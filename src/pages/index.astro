---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePreview from '../components/GuidePreview.astro';
import { getCollection } from 'astro:content';
import { homeSchema } from '../lib/schema';

/* Homepage shows three guides. The cost guide leads because it's the one
   picking up search impressions; edit this list to change the order. */
const featuredOrder = [
  'how-much-does-a-solicitor-website-cost',
  'does-your-firm-need-a-new-website',
  'how-clients-find-solicitors-online',
];

const all = await getCollection('posts', ({ data }) => !data.draft);
const featured = featuredOrder
  .map((slug) => all.find((p) => p.slug === slug))
  .filter((p): p is (typeof all)[number] => Boolean(p));
const rest = all
  .filter((p) => !featuredOrder.includes(p.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = [...featured, ...rest].slice(0, 3);

const notes = [
  { id: 'slow', text: 'The contact page takes ages to load on a phone' },
  { id: 'why', text: 'Nothing here says why a client should pick you' },
  { id: 'phone', text: 'Your phone number only appears in the footer' },
  { id: 'year', text: 'The copyright line still says 2017' },
];
---

<BaseLayout
  title="Solicitor Web Design Northern Ireland | Websites for Solicitors"
  description="Web design for solicitors and law firms in Northern Ireland. Websites that get found, look credible and bring in enquiries, plus plain-English guides and a free website review."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-tiles" aria-hidden="true">
      <span class="tile tile--lg tile--a">
        <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
      </span>
      <span class="tile tile--b tile--star">
        <svg viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"></path></svg>
      </span>
      <span class="tile tile--c">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
      </span>
      <span class="tile tile--lg tile--d">
        <svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      </span>
      <span class="tile tile--e tile--ink">
        <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      </span>
      <span class="tile tile--f">
        <svg viewBox="0 0 24 24"><path d="M12 14l4-4"></path><path d="M3.3 19a10 10 0 1 1 17.4 0"></path></svg>
      </span>
    </div>

    <div class="hero-inner">
      <h1>Web design for solicitors in Northern Ireland</h1>
      <p class="hero-lede">
        Websites for law firms that get found, look credible and turn visitors into
        enquiries, built and looked after by one person who knows the local market.
      </p>

      <form class="review-form" action="/#contact" method="get">
        <label for="firm-site">Your firm's website</label>
        <div class="review-field">
          <input id="firm-site" name="website" type="text" inputmode="url" autocomplete="url" placeholder="www.yourfirm.co.uk" required />
          <button type="submit" class="btn">Get my free review</button>
        </div>
        <p class="review-note">I'll look at it myself and email back honest, specific notes. No obligation, no sales pitch.</p>
      </form>
    </div>

    <figure class="review">
      <figcaption>What a free review looks like</figcaption>
      <div class="review-stage">
        <div class="mock" aria-hidden="true">
          <div class="mock-chrome">
            <i></i><i></i><i></i>
            <span class="mock-url">example-solicitors.co.uk</span>
          </div>
          <div class="mock-head">
            <span class="mock-logo">Example &amp; Co. Solicitors</span>
            <span class="mock-nav"><span>Home</span><span>About Us</span><span>Services</span><span>News</span><span>Contact</span></span>
          </div>
          <div class="mock-banner">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="2"></circle><path d="M21 17l-5-5-9 8"></path></svg>
            <span>Stock photo of a handshake</span>
          </div>
          <div class="mock-body">
            <div class="mock-col">
              <span class="mock-welcome">Welcome to our website</span>
              <i></i><i></i><i></i><i></i>
            </div>
            <div class="mock-col mock-col--offset">
              <i></i><i></i><i></i><i></i>
            </div>
          </div>
          <div class="mock-foot">
            <span>Tel: 028 XXXX XXXX</span>
            <span>&copy; 2017 Example &amp; Co. All rights reserved.</span>
          </div>
        </div>

        {notes.map((n) => <span class={`marker marker--${n.id}`} aria-hidden="true"></span>)}

        <ul class="review-notes">
          {notes.map((n) => <li class={`note note--${n.id}`}>{n.text}</li>)}
        </ul>
      </div>
    </figure>
  </section>

  <!-- GUIDES -->
  <section id="guides" class="guides">
    <div class="container">
      <div class="guides-head">
        <div>
          <h2>Straight answers before you spend a penny</h2>
          <p>The questions firms ask before commissioning or replacing a website, answered without the jargon or the sales spin.</p>
        </div>
        <a href="/blog/" class="btn btn--outline">See all guides</a>
      </div>

      {posts.length === 0 ? (
        <p class="guides-empty">Guides are on the way.</p>
      ) : (
        <div class="guide-grid">
          {posts.map((post) => (
            <a class="guide-card" href={`/blog/${post.slug}/`}>
              <GuidePreview slug={post.slug} />
              <div class="guide-text">
                <span class="guide-tag">{post.data.tag}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- WHAT I DO -->
  <section id="services" class="services">
    <div class="container services-split">
      <div class="services-intro">
        <h2>And when it's time to build</h2>
        <p class="services-lede">
          No account managers and no agency markup. You deal with the person doing the
          work, from the first conversation to the day-to-day upkeep.
        </p>
        <p class="services-proof">
          Built and looked after by Chris Kernaghan of <a href="https://wpbase.co.uk" target="_blank" rel="noopener">WP Base</a>,
          who also cares for sites for Catagen, ExportExplore and InclusionIQ.
        </p>
      </div>

      <ul class="service-list">
        <li class="service">
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18"></path></svg>
          </span>
          <div>
            <h3>New websites</h3>
            <p>A clean, credible site that reflects how your firm actually works, built to be found and easy to update.</p>
          </div>
        </li>
        <li class="service">
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path><path d="M3 21v-5h5"></path></svg>
          </span>
          <div>
            <h3>Redesigns and rescues</h3>
            <p>Tired, slow or broken sites brought up to standard without the runaround.</p>
          </div>
        </li>
        <li class="service">
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </span>
          <div>
            <h3>Ongoing care</h3>
            <p>Updates, security, backups and small changes kept on top of, so you never have to think about it.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact">
    <div class="contact-card">
      <div class="contact-copy">
        <h2>Get a free website review</h2>
        <p>
          Tell me about your firm's site and I'll take a proper look, then send back
          honest, specific notes like the ones above. No obligation and no sales pitch.
        </p>
        <div class="contact-direct">
          <a href="mailto:hello@wpbase.co.uk">hello@wpbase.co.uk</a>
          <a href="tel:+447379334695">07379 334695</a>
        </div>
      </div>
      <div class="fillout-wrapper">
        <div
          class="fillout-embed"
          data-fillout-id="jYdzYYJ7r9us"
          data-fillout-embed-type="standard"
          data-fillout-inherit-parameters
          data-fillout-dynamic-resize
        ></div>
        <script is:inline src="https://server.fillout.com/embed/v1/"></script>
      </div>
    </div>
  </section>
</BaseLayout>
