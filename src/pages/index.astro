---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Websites for Solicitors | Web Design for Northern Ireland Law Firms"
  description="Plain-English advice on websites for solicitors and law firms in Northern Ireland, from someone who builds them. Guides first, no hard sell."
>
  <!-- HERO: photography-led, advice-led copy -->
  <section class="hero">
    <div class="hero-split">
      <div class="hero-copy">
        <span class="hero-pill"><span class="dot"></span> Based in Northern Ireland</span>
        <h1>Websites for law firms, built by someone who gets the work</h1>
        <p class="lede">
          Plain-English advice on getting your firm's website right, from someone
          in Northern Ireland who builds them for a living. Read first. Talk to me
          if and when it's useful.
        </p>
        <div class="hero-cta">
          <a href="#guides" class="btn">Read the guides</a>
          <a href="#contact" class="link-arrow">Get a free website review <span>&rarr;</span></a>
        </div>
      </div>

      <div class="hero-stage">
        <div class="hero-image">
          <image src="../image/leading-banner-image.jpg" alt="Solicitor working at a desk" width="720" height="900" />
        </div>

        <!-- floating cards, legal-flavoured rather than ISO's location/date -->
        <div class="float-card float-card--one float-card--accent">
          <div class="fc-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <div>
            <div class="fc-title">Site health: good</div>
            <div class="fc-sub">Checked this morning</div>
          </div>
        </div>

        <div class="float-card float-card--two">
          <div class="fc-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l9 6 9-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
          </div>
          <div>
            <div class="fc-title">3 new enquiries</div>
            <div class="fc-sub">Through your contact form</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GUIDES: the main event (editorial index kept) -->
  <section id="guides" class="band">
    <div class="container">
      <div class="index-label" data-index="01">Guides<span class="index-rule"></span></div>
      <div class="section-head">
        <h2>Straight answers, before you spend a penny</h2>
        <p>The questions firms actually ask before commissioning or replacing a website, answered without the jargon or the sales spin.</p>
      </div>

      {posts.length === 0 ? (
        <p class="guides-empty">Guides are on the way.</p>
      ) : (
        <div class="guide-list">
          {posts.map((post, i) => (
            <a class="guide-entry" href={`/blog/${post.slug}`}>
              <div class="guide-num">{String(i + 1).padStart(2, '0')}</div>
              <div class="guide-main">
                <div class="guide-meta">
                  <span class="tag">{post.data.tag}</span>
                  <span>{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                </div>
                <h3 class="guide-title">{post.data.title}</h3>
                <p class="guide-desc">{post.data.description}</p>
              </div>
              <div class="guide-go" aria-hidden="true">&rarr;</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- WHAT I DO: demoted, now with a supporting image -->
  <section id="services" class="band band--tint">
    <div class="container">
      <div class="index-label" data-index="02">And if you need a hand<span class="index-rule"></span></div>
      <div class="services-split">
        <div>
          <div class="section-head" style="margin-bottom:2rem;">
            <h2>The building bit</h2>
            <p>When a firm decides it's time, this is the work I take on. No account managers, no agency markup, just me.</p>
          </div>
          <div class="services-grid">
            <div class="service-item">
              <h3>New websites</h3>
              <p>A clean, credible site that reflects how your firm actually works, built to be found and easy to update.</p>
            </div>
            <div class="service-item">
              <h3>Redesigns &amp; rescues</h3>
              <p>Tired, slow or broken sites brought up to standard without the runaround.</p>
            </div>
            <div class="service-item">
              <h3>Ongoing care</h3>
              <p>Updates, security, backups and small changes kept on top of, so you never have to think about it.</p>
            </div>
          </div>
          <p class="services-note">
            No obligation to take any of this up. The guides are there to be useful on their own.
            If you'd like a second pair of eyes on your current site, <a href="#contact">ask for a free review</a>.
          </p>
        </div>
        <div class="services-image">
          <image src="../image/law-office.jpg" alt="A law office interior" width="800" height="600" />
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT: soft -->
  <section id="contact" class="band">
    <div class="container">
      <div class="contact-inner">
        <span class="eyebrow">Get in touch</span>
        <h2>Free website review</h2>
        <p>Tell me about your firm's site and I'll take a proper look and send back honest, specific notes. No obligation, no sales pitch.</p>
        <div class="fillout-wrapper">
          <div
            style="width:100%;height:500px;"
            data-fillout-id="jYdzYYJ7r9us"
            data-fillout-embed-type="standard"
            data-fillout-inherit-parameters
            data-fillout-dynamic-resize
          ></div>
          <script src="https://server.fillout.com/embed/v1/"></script>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
