---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePreview from '../../components/GuidePreview.astro';
import { getCollection } from 'astro:content';
import { guidesIndexSchema } from '../../lib/schema';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Website Guides for Northern Ireland Law Firms | Websites for Solicitors"
  description="Plain-English guides on websites, costs and getting found online for solicitors and law firms in Northern Ireland."
  schema={guidesIndexSchema()}
>
  <section class="guides guides--page">
    <div class="container">
      <div class="guides-head">
        <div>
          <h1>Website guides for Northern Ireland law firms</h1>
          <p>Straight answers to the questions firms actually ask before commissioning or replacing a website.</p>
        </div>
      </div>

      {posts.length === 0 ? (
        <p class="guides-empty">Guides are on the way.</p>
      ) : (
        <div class="guide-grid">
          {posts.map((post) => (
            <a class="guide-card" href={`/blog/${post.slug}/`}>
              <GuidePreview slug={post.slug} />
              <div class="guide-text">
                <span class="guide-tag">{post.data.tag}</span>
                <h2 class="guide-title">{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
