---
import BaseLayout from './BaseLayout.astro';
import GuidePreview from '../components/GuidePreview.astro';

export interface Props {
  slug: string;
  title: string;
  description: string;
  tag: string;
  pubDate: Date;
  image?: string;
  imageAlt?: string;
}

const { slug, title, description, tag, pubDate, image, imageAlt } = Astro.props;

/* Placeholder SVGs fall back to the guide's illustration; a real photo (jpg, png, webp) is shown as-is. */
const usePhoto = image && !image.endsWith('.svg');
const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${title} | Websites for Solicitors`} description={description}>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <span class="post-tag">{tag}</span>
        <time class="post-date" datetime={pubDate.toISOString()}>{dateStr}</time>
      </div>
      <h1>{title}</h1>
      <p class="post-standfirst">{description}</p>
    </header>

    <div class="post-hero">
      {usePhoto ? (
        <img src={image} alt={imageAlt ?? ''} width="1000" height="560" />
      ) : (
        <GuidePreview slug={slug} />
      )}
    </div>

    <div class="post-body">
      <slot />
    </div>

    <div class="post-cta">
      <h2>Want a second pair of eyes on your site?</h2>
      <p>Send me your firm's website and I'll email back honest, specific notes. No obligation.</p>
      <a href="/#contact" class="btn">Get a free website review</a>
    </div>

    <div class="post-nav">
      <a href="/blog/">All guides</a>
      <a href="/#contact">Free website review</a>
    </div>
  </article>
</BaseLayout>
