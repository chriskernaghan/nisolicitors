---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  tag: string;
  pubDate: Date;
  image?: string;
  imageAlt?: string;
}

const { title, description, tag, pubDate, image, imageAlt } = Astro.props;
const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${title} | Websites for Solicitors`} description={description}>
  <article>
    <header class="post-header">
      <div class="post-meta" style="justify-content:center;">
        <span class="post-tag">{tag}</span>
        <span class="post-date">{dateStr}</span>
      </div>
      <h1>{title}</h1>
    </header>

    {image && (
      <div class="post-hero">
        <img src={image} alt={imageAlt ?? ''} width="1000" height="560" />
      </div>
    )}

    <div class="post-body">
      <slot />
      <div class="post-nav">
        <a href="/blog">&larr; All guides</a>
        <a href="/#contact">Get a free review &rarr;</a>
      </div>
    </div>
  </article>
</BaseLayout>